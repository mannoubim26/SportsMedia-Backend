# Sports Social Web Application — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

PORT=3000

# MySQL connection
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=sports_social_db

# JWT — run `make secret` to auto-generate a secure value
JWT_SECRET=_SECRET_
JWT_EXPIRES_IN=7d

# React frontend origin (used by CORS)
CLIENT_ORIGIN=http://localhost:5173
